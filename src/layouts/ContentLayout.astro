---
import BaseLayout from './BaseLayout.astro';
interface Props {
  frontmatter: { title: string; description?: string };
}
const {
  title,
  description = `${Astro.props.frontmatter.title} for Q Calendar, by Regnum Digital.`,
} = Astro.props.frontmatter;
---

<BaseLayout title={`${title} · Q Calendar`} description={description}>
  <article class="prose wrap" lang="en">
    <h1>{title}</h1>
    <slot />
  </article>
</BaseLayout>
